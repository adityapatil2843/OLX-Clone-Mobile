# API Server base URL (Uses localhost which our dynamic resolver automatically
# maps to 10.0.2.2 for Android Emulator, local Wi-Fi IP for Physical Devices, and localhost for Web/iOS Simulator)
EXPO_PUBLIC_API_URL=https://olx-clone-server-zngq.onrender.com
EXPO_PUBLIC_API_BASE_URL=https://olx-clone-server-zngq.onrender.com/api/v1

# Real-time WebSocket / Socket.IO Server URL
EXPO_PUBLIC_SOCKET_URL=https://olx-clone-server-zngq.onrender.com

# Optional: Uncomment and set your local machine IP if you want to explicitly override auto-detection:
# EXPO_PUBLIC_HOST_IP=10.183.243.252

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# App Branding
EXPO_PUBLIC_APP_NAME="OLX Clone Mobile"

# Default Locale: en | hi | mr
EXPO_PUBLIC_DEFAULT_LOCALE=en
