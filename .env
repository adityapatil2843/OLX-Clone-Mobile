# Local development configuration. Production values are supplied through EAS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000

# Real-time WebSocket / Socket.IO Server URL
EXPO_PUBLIC_SOCKET_URL=http://localhost:8000

# Optional: Uncomment and set your local machine IP if you want to explicitly override auto-detection:
# EXPO_PUBLIC_HOST_IP=192.168.1.100

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# App Branding
EXPO_PUBLIC_APP_NAME="Bazarr 360"

# Default Locale: en | hi | mr
EXPO_PUBLIC_DEFAULT_LOCALE=en
