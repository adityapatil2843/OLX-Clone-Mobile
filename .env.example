# ==============================================================================
# OLX-Clone Mobile Client Environment Variables (.env.example)
# ==============================================================================
# IMPORTANT SECURITY NOTE:
# Variables prefixed with EXPO_PUBLIC_* are bundled into the compiled client binary
# and are publicly accessible to anyone inspecting the app bundle.
# NEVER put private keys, secrets, service account credentials, or production signing
# keys in these variables or anywhere in client source code.
# ==============================================================================

# API Base URL (development fallback)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Real-time WebSocket / Socket.IO Server URL
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# App Branding
EXPO_PUBLIC_APP_NAME="OLX Clone Mobile"

# Default Locale: en | hi | mr
EXPO_PUBLIC_DEFAULT_LOCALE=en
